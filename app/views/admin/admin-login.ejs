<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="keywords" content="admin, login administrativo, painel controle, EcoGeneration">
  <meta name="description" content="Área de login administrativo - EcoGeneration">
  <title><%= titulo %> - ECOGENERATION</title>
  <link rel="stylesheet" href="/css/admin.css">
    <link rel="icon" href="/imagens/favicon2.png" type="image/png">
</head>
<body class="admin-body">
  <main class="admin-container">
    <section class="admin-login-box" aria-label="Login administrativo">
      <header class="admin-header">
        <h1>🔐 ADMIN ECOGENERATION</h1>
      
      </header>
      
      <% if (erro) { %>
        <aside class="alert alert-error" role="alert">
          <%= erro %>
        </aside>
      <% } %>
      
      <form method="POST" action="/admin-login" class="admin-form">
        <fieldset class="form-group">
          <label for="usuario">Usuário</label>
          <input 
            type="text" 
            id="usuario" 
            name="usuario" 
            placeholder="Digite o usuário" 
            required
          >
        </fieldset>
        
        <fieldset class="form-group">
          <label for="senha">Senha</label>
          <input 
            type="password" 
            id="senha" 
            name="senha" 
            placeholder="Digite a senha" 
            required
          >
          <label class="mostrar-senha-label">
            <input type="checkbox" onchange="toggleSenha('senha', this)"> Mostrar senha
          </label>
        </fieldset>
        
        <button type="submit" class="btn btn-primary btn-block">
          Entrar
        </button>
      </form>
      
      <footer class="admin-footer">
        <a href="/">Voltar à página inicial</a>
      </footer>
    </section>
  </main>

  <script src="/js/admin-login.js"></script>
  <script src="/js/senha-toggle.js"></script>

<!-- Simple-Notify -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/simple-notify@1/dist/simple-notify.css">
<script src="https://cdn.jsdelivr.net/npm/simple-notify@1/dist/simple-notify.min.js"></script>
<script>
  window.notify = function(status, text) {
    var titles = { success: "Sucesso!", error: "Erro", warning: "Atencao", info: "Informacao" };
    new Notify({ status: status, title: titles[status] || "Aviso", text: text, effect: "slide", speed: 300, showIcon: true, showCloseButton: true, autoclose: true, autotimeout: 4500, position: "right top" });
  };
</script>
<% if (typeof flashMessage !== "undefined" && flashMessage) { %>
<script>window.notify("<%= flashMessage.status %>", "<%= flashMessage.text %>");</script>
<% } %>
</body>
</html>
